# MSP Sentinel agent update helper (written by install/agent-install.sh). Runs as root, once per request: collects the
# staged release AS THE AGENT'S USER (root never touches the agent's folder), checks it against the pinned release key
# (/etc/sentinel-agent/release-key.pub), runs the new release's self-check as the agent's user, installs it, restarts
# the agent and rolls back if it doesn't stay up. See bin/agent-update-runner.php.
[Unit]
Description=MSP Sentinel agent update helper
# A request the helper can't remove must not make it run as root in a tight loop.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
# The result folder must exist before the sandbox is set up ("+": outside it). Root-owned, readable by the agent.
ExecStartPre=+/usr/bin/install -d -o root -g sentinel-agent -m 0750 /var/lib/sentinel-agent-update
ExecStart=__PHP__ __ROOT__/bin/agent-update-runner.php
TimeoutStartSec=900
# Hardening: it may only write the agent's code folder, its own result folder and the systemd units it owns, plus the
# agent's state folder, where ONLY the collector (running as the agent's user) removes the request. Root's own code
# never touches that folder (bin/agent-update-runner.php).
ProtectSystem=strict
ReadWritePaths=/opt /etc/systemd/system /var/lib/sentinel-agent-update /var/lib/sentinel-agent
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0027
